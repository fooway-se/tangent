Options -Indexes
DirectoryIndex app.html

<FilesMatch "^(app-root\.php|\.tangent-app-root|\.install-key|\.upgrade-key|config\.php|\.install\.lock|\.upgrade\.lock|config\.php\.lock)$">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self'; img-src 'self' data:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "no-referrer"
    <FilesMatch "^app\.html$">
        Header always set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^api/v1(?:/.*)?$ index.php [QSA,L]
</IfModule>
