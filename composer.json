{
  "name": "tangent/app",
  "description": "Self-hosted collaboration tool for developers",
  "type": "project",
  "license": "Apache-2.0",
  "require": {
    "php": ">=8.5.12",
    "ext-iconv": "*",
    "ext-intl": "*",
    "ext-mbstring": "*",
    "ext-pdo_mysql": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.5"
  },
  "autoload": {
    "psr-4": {
      "Tangent\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tangent\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit --configuration phpunit.xml"
  },
  "config": {
    "sort-packages": true
  }
}
